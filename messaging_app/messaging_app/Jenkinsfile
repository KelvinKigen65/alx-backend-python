pipeline {
    agent any
    
    environment {
        DOCKER_IMAGE = 'your-dockerhub-username/messaging-app'
        DOCKER_TAG = "${BUILD_NUMBER}"
        DOCKER_CREDENTIALS_ID = 'docker-hub-credentials'
        GIT_CREDENTIALS_ID = 'github-credentials'
    }
    
    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    credentialsId: "${GIT_CREDENTIALS_ID}",
                    url: 'https://github.com/your-username/alx-backend-python.git'
            }
        }
        
        stage('Setup Python Environment') {
            steps {
                dir('messaging_app') {
                    script {
                        // Using ShiningPanda plugin for Python environment
                        sh '''
                            python3 -m venv venv
                            . venv/bin/activate
                            pip install --upgrade pip
                            pip install -r requirements.txt
                            pip install pytest pytest-html pytest-cov
                        '''
                    }
                }
            }
        }
        
        stage('Run Tests') {
            steps {
                dir('messaging_app') {
                    script {
                        sh '''
                            . venv/bin/activate
                            export DJANGO_SETTINGS_MODULE=messaging_app.settings
                            python manage.py test --verbosity=2
                            pytest --html=reports/pytest_report.html --self-contained-html --cov=. --cov-report=html:reports/coverage_html --cov-report=xml:reports/coverage.xml
                        '''
                    }
                }
            }
            post {
                always {
                    dir('messaging_app') {
                        publishHTML([
                            allowMissing: false,
                            alwaysLinkToLastBuild: true,
                            keepAll: true,
                            reportDir: 'reports',
                            reportFiles: 'pytest_report.html',
                            reportName: 'PyTest Report'
                        ])
                        
                        publishHTML([
                            allowMissing: false,
                            alwaysLinkToLastBuild: true,
                            keepAll: true,
                            reportDir: 'reports/coverage_html',
                            reportFiles: 'index.html',
                            reportName: 'Coverage Report'
                        ])
                    }
                }
            }
        }
        
        stage('Code Quality Check') {
            steps {
                dir('messaging_app') {
                    script {
                        sh '''
                            . venv/bin/activate
                            pip install flake8
                            flake8 . --format=html --htmldir=reports/flake8_report --exclude=venv,migrations,__pycache__,*.pyc,manage.py,settings.py
                        '''
                    }
                }
            }
            post {
                always {
                    dir('messaging_app') {
                        publishHTML([
                            allowMissing: false,
                            alwaysLinkToLastBuild: true,
                            keepAll: true,
                            reportDir: 'reports/flake8_report',
                            reportFiles: 'index.html',
                            reportName: 'Flake8 Report'
                        ])
                    }
                }
            }
        }
        
        stage('Build Docker Image') {
            steps {
                dir('messaging_app') {
                    script {
                        def image = docker.build("${DOCKER_IMAGE}:${DOCKER_TAG}")
                        docker.withRegistry('https://registry.hub.docker.com', "${DOCKER_CREDENTIALS_ID}") {
                            image.push()
                            image.push("latest")
                        }
                    }
                }
            }
        }
        
        stage('Deploy') {
            steps {
                echo 'Deployment stage - Configure based on your deployment strategy'
                // Add deployment steps here
            }
        }
    }
    
    post {
        always {
            dir('messaging_app') {
                cleanWs()
            }
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}